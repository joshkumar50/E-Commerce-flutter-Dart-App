{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Customer App (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=.env.development"
      ]
    },
    {
      "name": "Admin App (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_admin.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=.env.development"
      ]
    },
    {
      "name": "Customer App (Web Server - Port 8080)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [
        "--web-port",
        "8080",
        "--web-hostname",
        "localhost"
      ],
      "toolArgs": [
        "--dart-define-from-file=.env.development"
      ]
    },
    {
      "name": "Admin App (Web Server - Port 8081)",
      "request": "launch",
